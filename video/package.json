{
  "name": "xionmetrical-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Render pipeline for the 30 s XionMetrical demo video (AI-assisted animation; narration generated with Piper TTS; procedurally generated sound effects).",
  "scripts": {
    "voice": "node scripts/voice.mjs",
    "voice:select": "node scripts/voice.mjs --select",
    "timeline": "node scripts/timeline.mjs",
    "audio": "node scripts/audio.mjs",
    "serve": "node scripts/server.mjs --port 4100",
    "render:test": "node scripts/render.mjs --from 0 --to 10 --out tmp/xionmetrical-test-0-10s.mp4",
    "render": "node scripts/render.mjs",
    "frame-test": "node scripts/frame-test.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.65.1"
  }
}
